# OptiCut Pro - Modèle de Configuration Environnement (.env)
# Copiez ce fichier vers .env dans votre dossier de données ou à la racine

# 🔐 Clé secrète JWT obligatoire pour la sécurité des tokens
# Pour générer une clé cryptographiquement sûre :
# Windows/Linux/Mac : python -c "import secrets; print(secrets.token_hex(32))"
# Linux/Mac : openssl rand -hex 32
JWT_SECRET_KEY=votre_cle_secrete_aleatoire_ici

# Durée de validité des tokens JWT (en heures, défaut : 8)
JWT_EXPIRE_HOURS=8

# Chemin personnalisé vers la base de données SQLite (Optionnel)
# DB_PATH=C:\OptiCut_Data\BaseDeDonnees\opticut.db

# Origines autorisées pour CORS (séparées par des virgules)
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
