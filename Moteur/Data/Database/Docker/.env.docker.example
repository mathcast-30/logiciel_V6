# OptiCut Pro - Configuration Docker Environnement (Exemple)
# Copiez ce fichier vers .env.docker et modifiez les valeurs secrètes avant de lancer docker-compose

# Base de données PostgreSQL
POSTGRES_DB=opticut_pro
POSTGRES_USER=opticut_user
POSTGRES_PASSWORD=definir_un_mot_de_passe_robuste_ici

# Interface pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@opticut.local
PGADMIN_PASSWORD=definir_un_mot_de_passe_admin_robuste_ici
